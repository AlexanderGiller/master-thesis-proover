digraph proof {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.45, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [arrowsize=0.7, color="#555555"];
  "a1" [label=<<FONT FACE="Courier">a1</FONT>  (axiom)<BR/><FONT FACE="Courier">?[Y]: p(Y)</FONT><BR/><FONT FACE="Courier">file(...)</FONT>>, fillcolor="#e6e6e6"];
  "a2" [label=<<FONT FACE="Courier">a2</FONT>  (axiom)<BR/><FONT FACE="Courier">![X]: q(X)</FONT><BR/><FONT FACE="Courier">file(...)</FONT>>, fillcolor="#e6e6e6"];
  "c" [label=<<FONT FACE="Courier">c</FONT>  (conjecture)<BR/><FONT FACE="Courier">?[Z]: (p(Z) &amp; q(Z))</FONT><BR/><FONT FACE="Courier">file(...)</FONT>>, fillcolor="#e6e6e6"];
  "skA" [label=<<FONT FACE="Courier">skA</FONT>  (plain)<BR/><FONT FACE="Courier">p(sK0)</FONT><BR/><FONT FACE="Courier">skolemize [esa]</FONT>>, fillcolor="#cfe2f7"];
  "instB" [label=<<FONT FACE="Courier">instB</FONT>  (plain)<BR/><FONT FACE="Courier">q(sK0)</FONT><BR/><FONT FACE="Courier">instantiate [thm]</FONT>>, fillcolor="#d5efd5"];
  "s" [label=<<FONT FACE="Courier">s</FONT>  (plain)<BR/><FONT FACE="Courier">(p(sK0) &amp; q(sK0))</FONT><BR/><FONT FACE="Courier">conjunction [thm]</FONT>>, fillcolor="#d5efd5"];
  "s2" [label=<<FONT FACE="Courier">s2</FONT>  (plain)<BR/><FONT FACE="Courier">?[Z]: (p(Z) &amp; q(Z))</FONT><BR/><FONT FACE="Courier">existential_gen [thm]</FONT>>, fillcolor="#d5efd5"];
  "negc" [label=<<FONT FACE="Courier">negc</FONT>  (negated_conjecture)<BR/><FONT FACE="Courier">~?[Z]: (p(Z) &amp; q(Z))</FONT><BR/><FONT FACE="Courier">negated_conjecture [cth]</FONT>>, fillcolor="#fbd9b5"];
  "bot" [label=<<FONT FACE="Courier">bot</FONT>  (plain)<BR/><FONT FACE="Courier">$false</FONT><BR/><FONT FACE="Courier">consequence [thm]</FONT>>, fillcolor="#fff0a8"];
  "a1" -> "skA";
  "a2" -> "instB";
  "skA" -> "s";
  "instB" -> "s";
  "s" -> "s2";
  "c" -> "negc";
  "negc" -> "bot";
  "s2" -> "bot";
  subgraph cluster_legend { label=""; style=invis;
    "leg_provenance" [label="provenance check (file source)", fillcolor="#e6e6e6", fontsize=9];
    "leg_negated" [label="negated-conjecture check", fillcolor="#fbd9b5", fontsize=9];
    "leg_provenance" -> "leg_negated" [style=invis];
    "leg_skolem" [label="Skolemization check", fillcolor="#cfe2f7", fontsize=9];
    "leg_negated" -> "leg_skolem" [style=invis];
    "leg_internal" [label="internal rule checker", fillcolor="#d5efd5", fontsize=9];
    "leg_skolem" -> "leg_internal" [style=invis];
    "leg_shortcut" [label="sound shortcut (no prover call)", fillcolor="#fff0a8", fontsize=9];
    "leg_internal" -> "leg_shortcut" [style=invis];
  }
}
